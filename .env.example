NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DEEPSEEK_API_KEY=
# Alternativas opcionais; DeepSeek é o provedor principal e os demais são fallbacks.
DEEPSEEK_API_KEY_2=
DEEPSEEK_MODEL=deepseek-v4-pro
GROQ_API_KEY=
# Fallbacks opcionais; a IA troca automaticamente quando um provedor atingir o limite.
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_API_KEY_2=
# Para mais projetos, também são aceitas GEMINI_API_KEY_3 até GEMINI_API_KEY_5.
GEMINI_MODEL=gemini-3.6-flash
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_OWNER_FIREBASE_UID=
# Pluggy: todas as credenciais abaixo são exclusivas do servidor.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# URL HTTPS pública, por exemplo https://app.exemplo.com/api/webhooks/pluggy
PLUGGY_WEBHOOK_URL=
# Gere um segredo longo e aleatório; ele será enviado no header do webhook.
PLUGGY_WEBHOOK_SECRET=
# Opcional: retorno OAuth cadastrado na Pluggy.
PLUGGY_OAUTH_REDIRECT_URI=
# Entre 30 e 365 dias. O padrão é 365.
PLUGGY_TRANSACTION_LOOKBACK_DAYS=365
# Sandbox só é exibido fora de produção.
PLUGGY_INCLUDE_SANDBOX=false
# Mantém iniciação de pagamentos/Pix bloqueada até ativação explícita.
PLUGGY_PAYMENTS_ENABLED=false
AUTHORIZED_FIREBASE_UIDS=
AUTHORIZED_GOOGLE_EMAILS=
ALLOWED_ORIGINS=https://www.psyzon.com.br
